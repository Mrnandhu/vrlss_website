.technology-eyebrow::before {
  content: "";
  width: 24px;
  height: 1px;
  background: #2563eb;
}

.technology-intro h2 {
  margin: 20px 0 16px;
  color: #10233f;
  font-size: clamp(42px, 5vw, 68px);
  font-weight: 650;
  line-height: 1;
  letter-spacing: -0.055em;
}

.technology-intro h2 em {
  color: #2563eb;
  font-style: normal;
}

.technology-intro p {
  max-width: 560px;
  margin: 0;
  color: #63738a;
  font-size: 15px;
  line-height: 1.75;
}

.technology-marquee-wrapper {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
  overflow: hidden;
}

.technology-marquee {
  position: relative;
  width: 100%;
  overflow: hidden;
  padding: 0;
  border-block: 1px solid #e3e9f1;
  background: transparent;
}

.technology-marquee::before,
.technology-marquee::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  z-index: 2;
  width: 12vw;
  pointer-events: none;
}

.technology-marquee::before {
  left: 0;
  background: linear-gradient(
    90deg,
    #f7f9fc 0%,
    rgba(247, 249, 252, 0) 100%
  );
}

.technology-marquee::after {
  right: 0;
  background: linear-gradient(
    270deg,
    #f7f9fc 0%,
    rgba(247, 249, 252, 0) 100%
  );
}

.technology-marquee-track {
  display: flex;
  width: max-content;
  animation: vrls-tech-left 42s linear infinite;
  will-change: transform;
}

.technology-marquee-reverse .technology-marquee-track {
  animation-name: vrls-tech-right;
  animation-duration: 50s;
}

.technology-item {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  min-height: 64px;
  padding: 0 28px;
  color: #304461;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: -0.01em;
  white-space: nowrap;
}

.technology-dot {
  width: 5px;
  height: 5px;
  flex: 0 0 5px;
  border-radius: 50%;
  background: #2563eb;
}

.technology-marquee:hover .technology-marquee-track {
  animation-play-state: paused;
}

@keyframes vrls-tech-left {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

@keyframes vrls-tech-right {
  from {
    transform: translateX(-50%);
  }

  to {
    transform: translateX(0);
  }
}

@media (max-width: 700px) {
  .technologies-section {
    padding: 78px 0 72px;
  }

  .technology-intro {
    width: calc(100% - 38px);
    margin-bottom: 38px;
  }

  .technology-intro h2 {
    font-size: clamp(40px, 11vw, 56px);
  }

  .technology-intro p {
    font-size: 14px;
  }

  .technology-item {
    min-height: 54px;
    padding: 0 20px;
    font-size: 12px;
  }

  .technology-marquee-track {
    animation-duration: 34s;
  }

  .technology-marquee-reverse .technology-marquee-track {
    animation-duration: 40s;
  }
}

@media (prefers-reduced-motion: reduce) {
  .technology-marquee-track {
    animation: none;
  }
}
