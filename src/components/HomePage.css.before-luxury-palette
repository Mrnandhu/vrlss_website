.technologies-section {
  position: relative;
  overflow: hidden;
  padding: 110px 0 100px;
  background: #f7f9fc;
  border-top: 1px solid #e5ebf3;
}

.technology-intro {
  width: min(1180px, calc(100% - 64px));
  margin: 0 auto 54px;
}

.technology-eyebrow {
