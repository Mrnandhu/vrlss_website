import { useState } from 'react'
import './SolutionShowcase.css'

const solutions = [
  {
    title: 'NOVA DEVELOPMENTS',
    category: 'Property & Development',
    description:
      'A premium digital presence for property developers, real estate companies and development projects. Built to present properties clearly and guide prospective buyers towards enquiries.',
  },
  {
    title: 'ATLAS INTERIORS',
