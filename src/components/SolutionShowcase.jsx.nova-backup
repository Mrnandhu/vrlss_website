  },
  {
    title: 'ALPHA CONTRACTING',
    category: 'Construction & Engineering',
    description:
      'A professional digital platform for contractors and engineering businesses. Structured around services, capabilities, projects and business enquiries.',
  },
  {
    title: 'MEDORA CLINIC',
    category: 'Healthcare & Clinics',
    description:
      'A clear and trustworthy website experience for clinics and specialist healthcare providers. Focused on services, specialists, facilities and patient enquiries.',
  },
  {
    title: 'MAJLIS HOSPITALITY',
    category: 'Restaurants & Hospitality',
    description:
      'A refined customer experience for restaurants, cafés and hospitality businesses. Designed around menus, atmosphere, services, reservations and customer discovery.',
  },
  {
    title: 'LUMI EVENTS',
    category: 'Events & Venues',
    description:
      'A visual-first digital presence for event companies, venues and wedding businesses. Built to present spaces, services, packages and enquiries.',
  },
  {
    title: 'MOTION AUTO',
    category: 'Automotive Services',
    description:
      'A conversion-focused experience for automotive workshops, detailing studios and vehicle service businesses. Customers can quickly understand services and request a visit.',
  },
